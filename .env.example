# Copy to `.env` on the droplet (never commit `.env`).
#   cp .env.example .env
#   chmod 600 .env
#
# Preferred: put a *hash* of the admin password here, not the password itself.
# Generate the hash on your laptop (so the plaintext never touches the droplet):
#   node deploy/hash-password.mjs
#
# Generate the session secret on your laptop:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

NODE_ENV=production
HOST=0.0.0.0
PORT=3000
LINEPROS_DB_PATH=/data/billing.db

# Auth is required in production. Do not set LINEPROS_AUTH=off on the droplet.
LINEPROS_AUTH=on
LINEPROS_ADMIN_USER=admin
LINEPROS_ADMIN_PASSWORD_HASH=
# LINEPROS_ADMIN_PASSWORD=   # avoid this; only use if you cannot generate a hash
LINEPROS_SESSION_SECRET=

# Set to true only after HTTPS is enabled (otherwise the login cookie will not stick).
LINEPROS_SECURE_COOKIES=false
